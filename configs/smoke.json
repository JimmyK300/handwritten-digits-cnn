{
  "description": "Tiny smoke test for CI: one seed, one epoch, 60 samples per writer.",
  "results_dir": "results_smoke",
  "workers": 1,
  "threads_per_worker": 2,
  "seeds": [
    0
  ],
  "protocols": [
    "sample_split",
    "lowo",
    "mnist_to_stylus",
    "custom_to_mnist"
