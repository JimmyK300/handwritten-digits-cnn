    ],
    "conditions": [
      "baseline",
      "dilate_k3_i1"
    ],
    "epochs": 1,
    "batch_size": 64,
    "learning_rate": 0.001,
    "mnist_train_subset": 200,
    "model": {
      "conv_channels": [
        8,
        16
      ],
      "kernel_sizes": [
        5,
        3
      ],
      "hidden_dim": 64
    }
  },
  "max_per_writer": 60,
  "mnist_train_subset": 300,
  "mnist_test_subset": 300,
  "protocol_conditions": {
    "custom_to_mnist": [
