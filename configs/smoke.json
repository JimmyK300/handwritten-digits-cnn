      2,
      1
    ],
    "hidden_dims": [
      128,
      32
    ],
    "num_classes": 10
  },
  "training": {
    "batch_size": 64,
    "learning_rate": 0.001,
    "epochs": 1
  },
  "conditions": {
    "baseline": {
      "preprocess": {}
    },
    "dilate_k3_i1": {
      "preprocess": {
        "dilate_kernel": 3,
        "dilate_iterations": 1
      }
    },
    "gain_1.5": {
